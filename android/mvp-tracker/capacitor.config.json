{
  "appId": "fm.m365.contributor",
  "appName": "M365.FM Contributor",
  "webDir": "www",
  "backgroundColor": "#f3f3f2",
  "server": {
    "url": "https://www.m365.fm/community/contributor/",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
