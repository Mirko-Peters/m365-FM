{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "{{TEAMS_BOT_APP_ID}}",
  "packageName": "fm.m365.teams",
  "developer": {
    "name": "M365.FM",
    "websiteUrl": "https://www.m365.fm/",
    "privacyUrl": "https://www.m365.fm/privacy/",
    "termsOfUseUrl": "https://www.m365.fm/legal/"
  },
  "name": {
    "short": "M365.FM",
    "full": "M365.FM Community"
  },
  "description": {
    "short": "Folge Themen und teile M365.FM-Inhalte.",
    "full": "Abonniere Entitäten, Creator und Events. Teile Folgen, Artikel, Updates und Events direkt in Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#3B6391",
  "bots": [
    {
      "botId": "{{TEAMS_BOT_APP_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            { "title": "follow", "description": "M365.FM-Thema suchen und abonnieren" },
            { "title": "my subscriptions", "description": "Meine Abos anzeigen" },
            { "title": "unfollow", "description": "Ein Abo beenden" }
          ]
        }
      ]
    }
  ],
  "composeExtensions": [
    {
      "botId": "{{TEAMS_BOT_APP_ID}}",
      "commands": [
        {
          "id": "search",
          "type": "query",
          "title": "M365.FM suchen",
          "description": "Folgen, Artikel, Updates, Events und Entitäten suchen",
          "initialRun": true,
          "parameters": [
            {
              "name": "query",
              "title": "Suchbegriff",
              "description": "M365.FM durchsuchen",
              "inputType": "text"
            }
          ]
        }
      ],
      "messageHandlers": [
        {
          "type": "link",
          "value": "https://www.m365.fm/*"
        }
      ]
    }
  ],
  "validDomains": ["api-dub.m365.fm", "www.m365.fm"],
  "permissions": ["identity"]
}
