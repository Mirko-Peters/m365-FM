  "stages": [
   {
    "title": {
     "en": "1. Foundations",
     "de": "1. Grundlagen"
    },
    "text": {
     "en": "The ideas behind continuous improvement, how leaders work on the floor, and the basic lean tools: 5S, kanban and quick changeover.",
     "de": "Die Ideen hinter kontinuierlicher Verbesserung, wie Führungskräfte am Ort des Geschehens arbeiten, und die Lean-Grundwerkzeuge 5S, Kanban und schnelles Rüsten."
    },
    "pillars": [
     "lean-manufacturing",
     "operational-excellence",
     "shop-floor-management",
     "5s-visual-management",
     "kanban-pull-system",
     "smed-changeover-reduction"
    ]
   },
   {
    "title": {
     "en": "2. See and measure",
     "de": "2. Sehen und messen"
    },
    "text": {
     "en": "Make the flow visible, measure it with a few meaningful numbers, keep the machines running and find the root causes of problems.",
     "de": "Den Fluss sichtbar machen, mit wenigen aussagekräftigen Kennzahlen messen, Anlagen verfügbar halten und Ursachen von Problemen finden."
    },
    "pillars": [
     "value-stream-mapping",
     "manufacturing-kpis",
     "tpm-oee",
     "six-sigma-root-cause-analysis"
    ]
   },
   {
    "title": {
     "en": "3. Plan and simulate",
     "de": "3. Planen und simulieren"
    },
    "text": {
     "en": "From sales and operations planning and MRP to finite-capacity scheduling, bottlenecks and digital twins of the factory.",
     "de": "Von Absatz- und Produktionsplanung und MRP über die Feinplanung mit endlichen Kapazitäten und Engpässe bis zum digitalen Zwilling der Fabrik."
    },
    "pillars": [
